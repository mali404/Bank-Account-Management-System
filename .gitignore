# Python / uv
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version.local

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# IDE / editor
.idea/
.vscode/
*.swp
.DS_Store

# Secrets / environment (ship .env.example only)
.env
.env.*
!.env.example

# Generated PKI material (no committed keys)
deploy/pki/secrets/
deploy/pki/.secrets/
deploy/pki/out/

# Results (git-ignored except the placeholder)
results/*
!results/.gitkeep

# Seeded runtime state. Regenerated by `make seed`; `make reset` copies snapshot/.
data/state/
data/manifest.json

# ISO 20022 XSDs are downloaded by `make bootstrap` (scripts/fetch_xsd.py) and
# verified against iso20022/xsd/MANIFEST.yaml; bindings are generated from them.
iso20022/xsd/*.xsd
iso20022/xsd/*.part
libs/agentbank_iso/src/agentbank_iso/gen/
