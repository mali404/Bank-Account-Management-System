# --- App ---
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://agentic_app:agentic_app_pw@postgres:5432/agentic_bank
DATABASE_SYNC_URL=postgresql+psycopg://agentic_app:agentic_app_pw@postgres:5432/agentic_bank
DATABASE_ADMIN_URL=postgresql+psycopg://agentic_admin:agentic_admin_pw@postgres:5432/agentic_bank

# --- Crypto ---
# Generate fresh keys for any non-local environment. See scripts/generate_keys.py.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
AUDIT_HMAC_KEY_PATH=/run/secrets/audit_hmac.key
DB_COLUMN_DEK_PATH=/run/secrets/db_column_dek.key

# --- LLM ---
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=6

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=agentic-bank
PROMETHEUS_ENABLED=true

# --- Rate limiting ---
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_DEFAULT=60/minute

# --- High-value approval threshold (USD) ---
HIGH_VALUE_THRESHOLD=5000.00
