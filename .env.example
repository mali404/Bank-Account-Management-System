# AgentBank-Sec Testbed — environment template.
# Copy to .env (git-ignored). `make bootstrap` creates .env from this file with
# freshly generated random passwords. NEVER commit a real .env. All values here
# are placeholders for a simulated, offline testbed (SPEC §17).

# Compose project name (keep stable so volumes/networks are reused).
COMPOSE_PROJECT_NAME=agentbank

# --- PostgreSQL (bank cores; schema per bank) ------------------------------
POSTGRES_USER=agentbank
POSTGRES_PASSWORD=change-me-generated-on-bootstrap
POSTGRES_DB=agentbank

# --- Keycloak (identity provider) ------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-generated-on-bootstrap

# --- step-ca (internal PKI) ------------------------------------------------
# The CA key-encryption password is generated on bootstrap and passed to the
# step-ca container non-interactively (DOCKER_STEPCA_INIT_PASSWORD). It stays in
# this git-ignored .env; no separate secret file or bind-mount is used.
STEPCA_INIT_NAME=AgentBank-Sec Internal CA
STEPCA_INIT_DNS_NAMES=step-ca,localhost
STEPCA_INIT_PROVISIONER_NAME=admin
STEPCA_INIT_PASSWORD=change-me-generated-on-bootstrap

# --- Safety: LLM egress ----------------------------------------------------
# 0 = no internet egress (default, simulation-only). 1 = allow the agent
# gateway to reach a hosted LLM API (SPEC §15 egress network, §17).
ALLOW_LLM_EGRESS=0
